# ==========================================
# 1. TEST API VERSIONING (Strict Header Check)
# ==========================================

### Should FAIL (400 Bad Request) - Missing X-API-Version Header
GET {{baseUrl}}/api/profiles
Authorization: Bearer {{token}}

### Should SUCCEED (200 OK) - Has Header
GET {{baseUrl}}/api/profiles
Authorization: Bearer {{token}}
X-API-Version: 1


# ==========================================
# 2. TEST PAGINATION & SEARCH (Analyst/Admin)
# ==========================================

### Get Profiles with Pagination Params
GET {{baseUrl}}/api/profiles?page=1&limit=5
Authorization: Bearer {{token}}
X-API-Version: 1

### Search Profiles
GET {{baseUrl}}/api/profiles/search?q=nigeria
Authorization: Bearer {{token}}
X-API-Version: 1


# ==========================================
# 3. TEST ROLE-BASED ACCESS (Admin Only)
# ==========================================

### Create Profile (Should succeed with Admin token, fail with Analyst token)
POST {{baseUrl}}/api/profiles
Authorization: Bearer {{token}}
X-API-Version: 1
Content-Type: application/json

{
  "name": "Harriet Tubman"
}


# ==========================================
# 4. TEST CSV EXPORT
# ==========================================

### Export filtered profiles to CSV
GET {{baseUrl}}/api/profiles/export?format=csv&gender=male&country=NG
Authorization: Bearer {{token}}
X-API-Version: 1


